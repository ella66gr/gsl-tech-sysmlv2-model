# Optional: copy to stack/.env (git-ignored) to change a default. The stack
# needs no settings and no licence; with no .env it runs on the defaults below.
#
# STORE_PORT=7210          # host port for the store (Fuseki), 127.0.0.1 only
# GATE_PORT=7220           # host port for the constraint gate, 127.0.0.1 only
# STORE_HEAP=2g            # the store's JVM heap
