# Copy to stack/.env (git-ignored) and set the licence path. README step 2.
#
# Absolute path to the GraphDB Free licence file for version 11.3. The file is
# mounted read-only into the GraphDB container as a Compose secret. Never copy
# it into this repository.
#   Mac:    GRAPHDB_LICENSE_FILE="/Users/<you>/Library/Application Support/GraphDB/work/graphdb.license"
#   Ubuntu: GRAPHDB_LICENSE_FILE="/home/<you>/graphdb/graphdb.license"
GRAPHDB_LICENSE_FILE=

# Optional overrides (defaults shown).
# GRAPHDB_PORT=7210        # host port for GraphDB (127.0.0.1 only)
# GATE_PORT=7220           # host port for the constraint gate (127.0.0.1 only)
# GRAPHDB_HEAP=2g          # GraphDB JVM heap
# GRAPHDB_REPOSITORY=cafe-runtime
