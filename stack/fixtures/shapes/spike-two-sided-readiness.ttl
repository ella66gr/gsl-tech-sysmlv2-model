# OP-134 spike follow-up (S519, Part D item 3): Cyril's two-sided readiness
# shapes, from session-519-op-134-cyril-shacl-classification §4.2, written in
# the stand-in vocabulary. NOT canon, and NOT a change to the stand-in shapes:
# this file sits beside them and is loaded only by the spike's capability
# check (item 9) and by `loadtest --shapes two-sided`, together with
# standin-shapes-core-only.ttl, in place of the stand-in SPARQL constraint.
#
# The stand-in vocabulary has one status property, cafe:status, for both the
# order's lifecycle and the line's preparation axis, so "lifecycle" and
# "preparation" below are both cafe:status.
#
# SHACL Core only: sh:or, sh:not, sh:in and sequence paths. No SPARQL.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cafe: <urn:ontara:standin:cafe#> .
@prefix sis:  <urn:ontara:standin:shapes#> .

# Shared: a value that is Ready or Collected.
sis:ReadyOrCollected a sh:NodeShape ;
  sh:in ( cafe:Ready cafe:Collected ) .

# 1. Order side, targeting the order: "lifecycle is not ready or collected, or
#    every line's preparation is ready or collected". sh:in applies to every
#    value node of hasLine/status, so the universal condition needs no SPARQL.
sis:OrderReadinessTwoSidedShape a sh:NodeShape ;
  sh:targetClass cafe:Order ;
  sh:message "An order is Ready or Collected only when every line is Ready or Collected."@en ;
  sh:or ( sis:OrderNotReadyOrCollected sis:OrderEveryLineReadyOrCollected ) .

sis:OrderNotReadyOrCollected a sh:NodeShape ;
  sh:property sis:OrderNotReadyOrCollected-status .
sis:OrderNotReadyOrCollected-status a sh:PropertyShape ;
  sh:path cafe:status ;
  sh:not sis:ReadyOrCollected .

sis:OrderEveryLineReadyOrCollected a sh:NodeShape ;
  sh:property sis:OrderEveryLineReadyOrCollected-lines .
sis:OrderEveryLineReadyOrCollected-lines a sh:PropertyShape ;
  sh:path ( cafe:hasLine cafe:status ) ;
  sh:in ( cafe:Ready cafe:Collected ) .

# 2. Line side, targeting the line: "its order's lifecycle is not ready or
#    collected, or its preparation is ready or collected".
sis:LineReadinessTwoSidedShape a sh:NodeShape ;
  sh:targetClass cafe:OrderLine ;
  sh:message "A line of an order that is Ready or Collected is itself Ready or Collected."@en ;
  sh:or ( sis:LineOrderNotReadyOrCollected sis:LineReadyOrCollected ) .

sis:LineOrderNotReadyOrCollected a sh:NodeShape ;
  sh:property sis:LineOrderNotReadyOrCollected-order .
sis:LineOrderNotReadyOrCollected-order a sh:PropertyShape ;
  sh:path ( cafe:lineOf cafe:status ) ;
  sh:not sis:ReadyOrCollected .

sis:LineReadyOrCollected a sh:NodeShape ;
  sh:property sis:LineReadyOrCollected-status .
sis:LineReadyOrCollected-status a sh:PropertyShape ;
  sh:path cafe:status ;
  sh:in ( cafe:Ready cafe:Collected ) .
