# Readiness rule (stand-in MRB mapping rule), in B8 form (S0.5 Pass B8).
# "An order whose every line is ready moves from in preparation to ready."
# SPARQL Update, run in the same request as the write that triggers it, and
# validated at commit. Semantics as the S515 stand-in (every line ready), with
# two corrections: it reads and writes the generated axis predicates and value
# IRIs, and it makes only the move the model permits (inPreparation -> ready,
# "PreparationComplete"). The real rule (ready or collected) is Pass C3's.
# It does NOT set mode or method: the labelling step does (labelling.rq).
# The runner supplies the graph ({{G}}, the graph the order was written to),
# {{O}} and {{EXEC}}. Every pattern names its graph.
PREFIX rec:         <urn:ontara:standin:rec#>
PREFIX cafe:        <urn:ontara:standin:cafe#>
PREFIX prov:        <http://www.w3.org/ns/prov#>
PREFIX ontara-cafe: <https://ontara.dev/ontology/tenant/cafe/>
DELETE { GRAPH <{{G}}> { ?order ontara-cafe:orderLifecycle ontara-cafe:OrderLifecycle-inPreparation } }
INSERT { GRAPH <{{G}}> {
  ?order ontara-cafe:orderLifecycle ontara-cafe:OrderLifecycle-ready .
  ?exec a prov:Activity ; prov:used rec:OrderReadiness-v1 .
  ?rr a rec:PlatformRecord ; rec:recordOf ?order ; rec:recordedAt ?now ;
      prov:wasGeneratedBy ?exec ; prov:wasDerivedFrom ?lineRecord .
} }
WHERE {
  VALUES (?order ?exec) { (<{{O}}> <{{EXEC}}>) }
  GRAPH <{{G}}> {
    ?order a ontara-cafe:Order ;
           ontara-cafe:orderLifecycle ontara-cafe:OrderLifecycle-inPreparation .
    FILTER NOT EXISTS {
      ?order cafe:hasLine ?l .
      FILTER NOT EXISTS { ?l ontara-cafe:orderLinePreparation ontara-cafe:OrderLinePreparation-ready }
    }
    ?order cafe:hasLine ?line .
    ?lineRecord rec:recordOf ?line .
  }
  BIND (IRI(CONCAT(STR(?order), "/ready-record")) AS ?rr)
  BIND (NOW() AS ?now)
}
