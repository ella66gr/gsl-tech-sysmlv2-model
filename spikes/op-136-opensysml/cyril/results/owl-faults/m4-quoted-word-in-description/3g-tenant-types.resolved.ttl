@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix ontara-bmm: <https://ontara.dev/ontology/bmm/> .
@prefix ontara-cafe: <https://ontara.dev/ontology/tenant/cafe/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://ontara.dev/ontology/tenant-types/> a owl:Ontology ;
    rdfs:label "Ontara Tenant Canonical Runtime Types"@en ;
    rdfs:comment "Generated by gen_owl_pipeline.py (Stage 3g, Session 518). Tenant part defs that specialise CanonicalRuntimeType and carry @BfoType, each in its tenant's ontology namespace, grounded under its BFO or IAO parent. Merged with the BMM ontology (ontara-bmm.ttl) in the stack; declares no imports, as ontara-bmm.ttl declares none."@en .

ontara-cafe:Order a owl:Class ;
    rdfs:label "Order"@en ;
    rdfs:comment "A customer's order of one or more items, with its lifecycle and payment status."@en ;
    rdfs:subClassOf bfo:IAO_0000030,
        ontara-bmm:CanonicalRuntimeType ;
    skos:definition "What a customer asked for, as one or more order lines. An order carries two independent statuses. Its lifecycle runs from placed through in preparation and ready to collected, and follows its lines: it is never moved to ready or collected directly. It can be cancelled at the counter before it is ready. Its payment runs from unpaid to paid, taken at the till."@en .

ontara-cafe:OrderLine a owl:Class ;
    rdfs:label "Order Line"@en ;
    rdfs:comment "One item asked for on an order, with its quantity and its own preparation status."@en ;
    rdfs:subClassOf bfo:IAO_0000030,
        ontara-bmm:CanonicalRuntimeType ;
    skos:definition "One item on a customer order, with its quantity and, optionally, who it is for. Each line is prepared and collected on its own, so it carries its own preparation status: queued, in preparation, ready, collected, or cancelled if its order is cancelled. A line cannot start preparation until its order is paid."@en .

