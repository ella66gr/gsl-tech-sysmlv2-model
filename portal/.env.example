# Portal environment variables.
#
# Copy this file to `.env` and fill in real values for local development.
#
# RESOLVER_BASE_URL — FastAPI resolver base URL.
#                     Default: http://localhost:7310
# RESOLVER_TOKEN    — Bearer token for the substrate write API and
#                     token-protected reads. The Portal holds this
#                     server-side; it is never sent to the browser.
#                     Source: 02 ONTARA/db/resolver/.ontara-token

RESOLVER_BASE_URL=http://localhost:7310
RESOLVER_TOKEN=
