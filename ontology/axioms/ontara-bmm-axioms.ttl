@prefix : <https://ontara.dev/ontology/bmm/axioms#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontara-bmm: <https://ontara.dev/ontology/bmm/> .
@prefix ontara-axis: <https://ontara.dev/ontology/bmm/axis#> .
@base <https://ontara.dev/ontology/bmm/axioms> .

<https://ontara.dev/ontology/bmm/axioms> rdf:type owl:Ontology ;
                                          owl:imports ontara-bmm: ;
                                          dcterms:created "2026-04-02"^^xsd:date ;
                                          rdfs:comment "Hand-authored OWL axioms for the Ontara BMM. Phase 2 Steps 1-3: concern group disjointness, object property declarations, and cardinality restrictions. OWL-authoritative (B29)."@en ;
                                          rdfs:label "Ontara BMM Axioms"@en ;
                                          owl:versionInfo "Session 114 — Steps 1-3: disjointness axioms, 13 object property declarations, 9 cardinality restrictions. Session 518 (S0.4) — status-axis family: 3 object properties, 11 data properties, 1 annotation property, 1 disjointness axiom."@en .

#################################################################
#    Object Properties
#################################################################

###  https://ontara.dev/ontology/bmm/axioms#hasActivityType
:hasActivityType rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain ontara-bmm:ActivityRecord ;
                 rdfs:range ontara-bmm:ActivityType ;
                 rdfs:comment "The activity type that this record documents. SysML: ActivityRecord.activityType [1]."@en ;
                 rdfs:label "has activity type"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasAffectedResource
:hasAffectedResource rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdf:type owl:FunctionalProperty ;
                     rdfs:domain ontara-bmm:ResourceConstraint ;
                     rdfs:range ontara-bmm:ResourceType ;
                     rdfs:comment "The resource type whose availability this constraint limits. SysML: ResourceConstraint.affectedResource [1]."@en ;
                     rdfs:label "has affected resource"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasAllocatedActivityType
:hasAllocatedActivityType rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdf:type owl:FunctionalProperty ;
                          rdfs:domain ontara-bmm:ActivityCostAllocation ;
                          rdfs:range ontara-bmm:ActivityType ;
                          rdfs:comment "The activity type to which this cost allocation applies. SysML: ActivityCostAllocation.activityType [1]."@en ;
                          rdfs:label "has allocated activity type"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasBudgetActivityType
:hasBudgetActivityType rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain ontara-bmm:ActivityBudget ;
                       rdfs:range ontara-bmm:ActivityType ;
                       rdfs:comment "The activity type for which this budget allocates planned volume. SysML: ActivityBudget.activityType [1]."@en ;
                       rdfs:label "has budget activity type"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasCatalogueEntry
:hasCatalogueEntry rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain ontara-bmm:InventoryRecord ;
                   rdfs:range ontara-bmm:CatalogueEntry ;
                   rdfs:comment "The catalogue entry whose stock level this inventory record tracks. SysML: InventoryRecord.catalogueEntry [1]."@en ;
                   rdfs:label "has catalogue entry"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasEnabledServiceOffering
:hasEnabledServiceOffering rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf owl:topObjectProperty ;
                           rdfs:domain ontara-bmm:Capability ;
                           rdfs:range ontara-bmm:ServiceOffering ;
                           rdfs:comment "A service offering that this capability enables. SysML: Capability.enabledServiceOfferings [0..*]."@en ;
                           rdfs:label "has enabled service offering"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasLinkedResource
:hasLinkedResource rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain ontara-bmm:CostDriver ;
                   rdfs:range ontara-bmm:ResourceType ;
                   rdfs:comment "A resource type whose cost behaviour this driver characterises. SysML: CostDriver.linkedResource [0..*]."@en ;
                   rdfs:label "has linked resource"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasOffering
:hasOffering rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain ontara-bmm:UnitEconomics ;
             rdfs:range ontara-bmm:ServiceOffering ;
             rdfs:comment "The service offering whose unit economics this instance describes. SysML: UnitEconomics.offering [1]."@en ;
             rdfs:label "has offering"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasPricingModel
:hasPricingModel rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain ontara-bmm:RevenueStream ;
                 rdfs:range ontara-bmm:PricingModel ;
                 rdfs:comment "The pricing model that governs this revenue stream. SysML: RevenueStream.pricingModel [1]."@en ;
                 rdfs:label "has pricing model"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasRelatedGovernanceRequirement
:hasRelatedGovernanceRequirement rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:domain ontara-bmm:StakeholderRelationship ;
                                 rdfs:range ontara-bmm:GovernanceRequirement ;
                                 rdfs:comment "A governance requirement associated with this stakeholder relationship. SysML: StakeholderRelationship.relatedGovernanceRequirements [0..*]."@en ;
                                 rdfs:label "has related governance requirement"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasRelatedServiceOffering
:hasRelatedServiceOffering rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf owl:topObjectProperty ;
                           rdfs:domain ontara-bmm:ParticipationModel ;
                           rdfs:range ontara-bmm:ServiceOffering ;
                           rdfs:comment "A service offering to which this participation model applies. SysML: ParticipationModel.relatedServiceOffering [0..*]."@en ;
                           rdfs:label "has related service offering"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasResourceType
:hasResourceType rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain ontara-bmm:ResourceInstance ;
                 rdfs:range ontara-bmm:ResourceType ;
                 rdfs:comment "The resource type that this instance instantiates. SysML: ResourceInstance.resourceType [1]."@en ;
                 rdfs:label "has resource type"@en .


###  https://ontara.dev/ontology/bmm/axioms#hasTargetSegment
:hasTargetSegment rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain ontara-bmm:ValueProposition ;
                  rdfs:range ontara-bmm:CustomerSegment ;
                  rdfs:comment "The customer segment to which a value proposition is addressed. SysML: ValueProposition.targetSegment [1]."@en ;
                  rdfs:label "has target segment"@en .


#################################################################
#    Cardinality Restrictions (Step 3)
#################################################################

###  Every ValueProposition has exactly one target CustomerSegment.
ontara-bmm:ValueProposition rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasTargetSegment ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass ontara-bmm:CustomerSegment
                                            ] .

###  Every InventoryRecord has exactly one CatalogueEntry.
ontara-bmm:InventoryRecord rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasCatalogueEntry ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass ontara-bmm:CatalogueEntry
                                           ] .

###  Every ActivityCostAllocation has exactly one allocated ActivityType.
ontara-bmm:ActivityCostAllocation rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty :hasAllocatedActivityType ;
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass ontara-bmm:ActivityType
                                                  ] .

###  Every ActivityBudget has exactly one budget ActivityType.
ontara-bmm:ActivityBudget rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasBudgetActivityType ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass ontara-bmm:ActivityType
                                          ] .

###  Every ActivityRecord has exactly one ActivityType.
ontara-bmm:ActivityRecord rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasActivityType ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass ontara-bmm:ActivityType
                                          ] .

###  Every ResourceInstance has exactly one ResourceType.
ontara-bmm:ResourceInstance rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasResourceType ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass ontara-bmm:ResourceType
                                            ] .

###  Every ResourceConstraint has exactly one affected ResourceType.
ontara-bmm:ResourceConstraint rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                owl:onProperty :hasAffectedResource ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass ontara-bmm:ResourceType
                                              ] .

###  Every RevenueStream has exactly one PricingModel.
ontara-bmm:RevenueStream rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasPricingModel ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass ontara-bmm:PricingModel
                                         ] .

###  Every UnitEconomics has exactly one ServiceOffering.
ontara-bmm:UnitEconomics rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasOffering ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass ontara-bmm:ServiceOffering
                                         ] .


#################################################################
#    Classes
#################################################################

###  https://ontara.dev/ontology/bmm/ActivityModelElement
ontara-bmm:ActivityModelElement rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:unionOf ( ontara-bmm:ActivityBudget
                                                                    ontara-bmm:ActivityCostAllocation
                                                                    ontara-bmm:ActivityGranularity
                                                                    ontara-bmm:ActivityRecord
                                                                    ontara-bmm:ActivityType
                                                                  )
                                                    ] ;
                                rdfs:comment "Union class collecting all BMM classes in the ActivityModel concern group."@en ;
                                rdfs:label "Activity Model Element"@en .


###  https://ontara.dev/ontology/bmm/FinancialPlanningElement
ontara-bmm:FinancialPlanningElement rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Class ;
                                                          owl:unionOf ( ontara-bmm:CostDriver
                                                                        ontara-bmm:FinancialProjection
                                                                        ontara-bmm:PricingModel
                                                                        ontara-bmm:RevenueStream
                                                                        ontara-bmm:UnitEconomics
                                                                      )
                                                        ] ;
                                    rdfs:comment "Union class collecting all BMM classes in the FinancialPlanning concern group."@en ;
                                    rdfs:label "Financial Planning Element"@en .


###  https://ontara.dev/ontology/bmm/GovernanceMappingElement
ontara-bmm:GovernanceMappingElement rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Class ;
                                                          owl:unionOf ( ontara-bmm:AuditEvidenceRecord
                                                                        ontara-bmm:GovernanceRequirement
                                                                      )
                                                        ] ;
                                    rdfs:comment "Union class collecting all BMM classes in the GovernanceMapping concern group."@en ;
                                    rdfs:label "Governance Mapping Element"@en .


###  https://ontara.dev/ontology/bmm/ResourcePlanningElement
ontara-bmm:ResourcePlanningElement rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:unionOf ( ontara-bmm:Capability
                                                                       ontara-bmm:CapacityModel
                                                                       ontara-bmm:InventoryRecord
                                                                       ontara-bmm:ObjectiveCapabilityMapping
                                                                       ontara-bmm:ResourceConstraint
                                                                       ontara-bmm:ResourceInstance
                                                                       ontara-bmm:ResourceType
                                                                     )
                                                       ] ;
                                   rdfs:comment "Union class collecting all BMM classes in the ResourcePlanning concern group."@en ;
                                   rdfs:label "Resource Planning Element"@en .


###  https://ontara.dev/ontology/bmm/ServiceConceptElement
ontara-bmm:ServiceConceptElement rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Class ;
                                                       owl:unionOf ( ontara-bmm:CatalogueEntry
                                                                     ontara-bmm:Channel
                                                                     ontara-bmm:CustomerSegment
                                                                     ontara-bmm:DifferentiationClaim
                                                                     ontara-bmm:ExternalReference
                                                                     ontara-bmm:ServiceOffering
                                                                     ontara-bmm:ServiceParticipant
                                                                     ontara-bmm:ServiceSubject
                                                                     ontara-bmm:ValueProposition
                                                                   )
                                                     ] ;
                                 rdfs:comment "Union class collecting all BMM classes in the ServiceConcept concern group."@en ;
                                 rdfs:label "Service Concept Element"@en .


###  https://ontara.dev/ontology/bmm/StakeholderModelElement
ontara-bmm:StakeholderModelElement rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:unionOf ( ontara-bmm:CommunityRelationship
                                                                       ontara-bmm:CooperativeArrangement
                                                                       ontara-bmm:ExternalDependency
                                                                       ontara-bmm:ParticipationModel
                                                                       ontara-bmm:ReferralPathway
                                                                       ontara-bmm:StakeholderRelationship
                                                                     )
                                                       ] ;
                                   rdfs:comment "Union class collecting all BMM classes in the StakeholderModel concern group."@en ;
                                   rdfs:label "Stakeholder Model Element"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontara-bmm:ActivityModelElement
                ontara-bmm:FinancialPlanningElement
                ontara-bmm:GovernanceMappingElement
                ontara-bmm:ResourcePlanningElement
                ontara-bmm:ServiceConceptElement
                ontara-bmm:StakeholderModelElement
              )
] .


#################################################################
#    Status-axis family (Session 518, Plan B Stage 0 S0.4)
#################################################################
#
# H-0311, OP-32 part a. The classes StatusAxis, ValueSpace,
# AxisTransition, AxisPrecondition (all IAO information content entity)
# and CanonicalRuntimeType (BFO entity) are generated by the pipeline
# from the BMM General package CanonicalRuntime. What the pipeline cannot
# generate is authored here: the properties that carry an axis
# declaration as individuals, and one disjointness axiom.
#
# Competency questions answered (session-518-s04-step1-cyril.md §5):
#   CQ1 Which axes does a canonical runtime type declare, with what
#       values, shape and default?
#   CQ2 Which moves does an axis permit, from what to what, triggered by
#       which event, written by which authority?
#   CQ3 Which preconditions guard a move: on which axis, of which related
#       instance, requiring which values?
#   CQ4 Under which BFO/IAO class is a canonical runtime type grounded?
#       (answered by the generated subclass axioms alone)
#
# Namespace: the axis-family properties are minted in ontara-axis:
# (https://ontara.dev/ontology/bmm/axis#), not ontara-ax:. ontara-ax: is
# the pipeline's namespace for properties derived from typed refs
# (mapping-rules.yaml object_property_mapping); this file restates those
# and the round-trip diff (diff_kg.py) treats every ontara-ax: object
# property as pipeline output. These are hand-authored only, so they
# carry their own namespace (authority zone OWL-authoritative).
#
# Choices:
#   - axisDeclaredOn is an annotation property, so an axis individual can
#     point at the class that declares it without punning the class as an
#     individual. The reasoner does not need to know it; SPARQL does.
#   - No functional or inverse object properties, no unions, no universal
#     restrictions (the EL traps). Object properties carry domain and range
#     because each is used by exactly one kind of subject; with the
#     disjointness axiom this makes a mis-typed declaration inconsistent.
#   - Data properties carry ranges only, no domains (a domain is an
#     inference rule, and several are shared across the family).
#   - Transition labels and rejection reasons are rdfs:label and
#     rdfs:comment on the individuals; no property is minted for them.
#   - Value ordering of an ordered enumeration is not stated in OWL (RDF
#     lists take a store out of DL). The order lives in the model.

###  https://ontara.dev/ontology/bmm/axis#axisDeclaredOn
ontara-axis:axisDeclaredOn rdf:type owl:AnnotationProperty ;
                rdfs:label "axis declared on"@en ;
                rdfs:comment "The canonical runtime type (an OWL class) that declares this status axis. Annotation property: links a StatusAxis individual to a class IRI without punning. SysML: a StatusAxis part usage inside a part def that specialises CanonicalRuntimeType."@en .

###  https://ontara.dev/ontology/bmm/axis#hasValueSpace
ontara-axis:hasValueSpace rdf:type owl:ObjectProperty ;
               rdfs:domain ontara-bmm:StatusAxis ;
               rdfs:range ontara-bmm:ValueSpace ;
               rdfs:label "has value space"@en ;
               rdfs:comment "The value space of a status axis. SysML: StatusAxis.valueSpace."@en .

###  https://ontara.dev/ontology/bmm/axis#permitsTransition
ontara-axis:permitsTransition rdf:type owl:ObjectProperty ;
                   rdfs:domain ontara-bmm:StatusAxis ;
                   rdfs:range ontara-bmm:AxisTransition ;
                   rdfs:label "permits transition"@en ;
                   rdfs:comment "A move the status axis permits. The permitted set is exhaustive in the model; that closure is checked by the generated guard and by SHACL, not by OWL. SysML: StatusAxis.permittedTransitions."@en .

###  https://ontara.dev/ontology/bmm/axis#hasPrecondition
ontara-axis:hasPrecondition rdf:type owl:ObjectProperty ;
                 rdfs:domain ontara-bmm:AxisTransition ;
                 rdfs:range ontara-bmm:AxisPrecondition ;
                 rdfs:label "has precondition"@en ;
                 rdfs:comment "A cross-axis precondition guarding this move. All of a move's preconditions must hold. SysML: AxisTransition.preconditions."@en .

###  Data properties (ranges only)

ontara-axis:axisName rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string ;
          rdfs:label "axis name"@en ;
          rdfs:comment "The name of a status axis, unique within its declaring type. SysML: StatusAxis.axisName."@en .

ontara-axis:defaultValue rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "default value"@en ;
              rdfs:comment "The value an axis holds when an instance is created. SysML: StatusAxis.defaultValue."@en .

ontara-axis:valueShape rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:string ;
            rdfs:label "value shape"@en ;
            rdfs:comment "unorderedEnum, orderedEnum or structuredValue. SysML: ValueSpace.valueShape."@en .

ontara-axis:enumValue rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           rdfs:label "enumeration value"@en ;
           rdfs:comment "One permitted value of an enumerated value space. SysML: ValueSpace.enumValues."@en .

ontara-axis:fromValue rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           rdfs:label "from value"@en ;
           rdfs:comment "The value a move starts from. SysML: AxisTransition.fromValue."@en .

ontara-axis:toValue rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string ;
         rdfs:label "to value"@en ;
         rdfs:comment "The value a move ends at. SysML: AxisTransition.toValue."@en .

ontara-axis:triggerEvent rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "trigger event"@en ;
              rdfs:comment "The name of the event that triggers a move. SysML: AxisTransition.triggerEvent (S518)."@en .

ontara-axis:requiredAuthority rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:string ;
                   rdfs:label "required authority"@en ;
                   rdfs:comment "An AxisAuthority value (operatorSide, customerSide, systemSide, inferenceSide, syntheticSide, platformSide) permitted to write a move. SysML: AxisTransition.requiredAuthority."@en .

ontara-axis:relatedVia rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:string ;
            rdfs:label "related via"@en ;
            rdfs:comment "The name of the single-valued reference, on the type declaring the guarded axis, that reaches the instance whose axis a precondition reads. Absent: the same instance. SysML: AxisPrecondition.relatedVia (S518)."@en .

ontara-axis:requiredAxis rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "required axis"@en ;
              rdfs:comment "The axisName of the axis a precondition reads. SysML: AxisPrecondition.requiredAxis (S518)."@en .

ontara-axis:requiredValue rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "required value"@en ;
               rdfs:comment "One value the required axis may hold for the guarded move to be permitted (any one suffices). SysML: AxisPrecondition.requiredValues (S518)."@en .

###  An axis specification, its value space, a move, a precondition and a
###  canonical runtime instance are never one another.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ontara-bmm:AxisPrecondition
                ontara-bmm:AxisTransition
                ontara-bmm:CanonicalRuntimeType
                ontara-bmm:StatusAxis
                ontara-bmm:ValueSpace
              )
] .


