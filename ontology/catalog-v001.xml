<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- OWL API XML Catalog for local IRI resolution.
     Maps ontology IRIs to local file paths so that Robot, Protégé,
     and other OWL tools can resolve imports without network access.

     Session 117: Created to resolve ontara-bmm: import in axioms
     and properties files during Robot reasoning.
     Session 150: Added PROV-O core subset and reasoning vocabulary. -->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog"
         prefer="public">

    <!-- Ontara BMM domain ontology (pipeline-generated) -->
    <uri name="https://ontara.dev/ontology/bmm/"
         uri="../generated/ontology/ontara-bmm.ttl"/>

    <!-- Ontara tenant canonical runtime types (pipeline-generated, Stage 3g, Session 518, S0.4).
         Tenant classes in their tenant's namespace (https://ontara.dev/ontology/<tenant>/). -->
    <uri name="https://ontara.dev/ontology/tenant-types/"
         uri="../generated/ontology/ontara-tenant-types.ttl"/>

    <!-- Ontara BMM axioms (hand-authored, OWL-authoritative) -->
    <uri name="https://ontara.dev/ontology/bmm/axioms"
         uri="axioms/ontara-bmm-axioms.ttl"/>

    <!-- Ontara Governance Vocabulary (hand-authored, OWL-authoritative, Session 126) -->
    <uri name="https://ontara.dev/ontology/governance/"
         uri="governance/ontara-governance.ttl"/>

    <!-- Ontara Domain Identity Vocabulary (hand-authored, OWL-authoritative, Session 144) -->
    <uri name="https://ontara.dev/ontology/domain/"
         uri="domain/ontara-domain.ttl"/>

    <!-- W3C PROV-O Core Subset (Starting Point classes and properties, Session 150) -->
    <uri name="http://www.w3.org/ns/prov#core"
         uri="imports/prov-core.ttl"/>

    <!-- Ontara Reasoning Vocabulary (hand-authored, OWL-authoritative, Session 150) -->
    <uri name="https://ontara.dev/ontology/reasoning/"
         uri="reasoning/ontara-reasoning.ttl"/>

    <!-- Cafe Reasoning Instances (hand-authored, Session 518, S0.4; H-0055) -->
    <uri name="https://ontara.dev/data/cafe/reasoning/"
         uri="reasoning/cafe-reasoning-instances.ttl"/>

    <!-- Ontara Platform Record Module (hand-authored, OWL only, Session 514, OP-125 / ADR-011)
         Shared content at PML, outside the FGZ. Namespace names no layer.
         Versioned: owl:versionIRI https://ontara.dev/ontology/record/2026-10-29/ontara-record.ttl -->
    <uri name="https://ontara.dev/ontology/record/"
         uri="record/ontara-record.ttl"/>
    <uri name="https://ontara.dev/ontology/record/2026-10-29/ontara-record.ttl"
         uri="record/ontara-record.ttl"/>

    <!-- MIREOT extract of IAO for the platform record module (ROBOT 1.9.8, Session 514).
         Keeps the BFO continuant/occurrent disjointness. Used for the module's EL check (T2). -->
    <uri name="https://ontara.dev/ontology/record/imports/iao-extract"
         uri="record/imports/iao-extract.owl"/>
    <uri name="https://ontara.dev/ontology/record/imports/2026-10-29/iao-extract.owl"
         uri="record/imports/iao-extract.owl"/>

    <!-- Ontara Cross-Layer Join Axioms (hand-authored, OWL-authoritative, W-161 / 2026-05-12)
         Shared declaration locus for cross-layer object properties (currently the
         satisfies / satisfiedBy pair binding controls to regulatory requirements).
         Owned by neither side; imported by both controls and requirements. -->
    <uri name="https://ontara.dev/ontology/joins/axioms"
         uri="joins/ontara-joins-axioms.ttl"/>

    <!-- Ontara Cross-Layer Join Shapes (hand-authored SHACL, W-161 / 2026-05-12)
         SHACL validation rules for the cross-layer joins. Shapes are author-and-park:
         each shape carries sh:deactivated true until its activating PR lands. -->
    <uri name="https://ontara.dev/ontology/joins/shapes"
         uri="joins/ontara-joins-shapes.ttl"/>

</catalog>
