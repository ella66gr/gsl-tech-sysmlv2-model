@prefix cafe-rsn: <https://ontara.dev/data/cafe/reasoning/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontara-axis: <https://ontara.dev/ontology/bmm/axis#> .
@prefix ontara-bmm: <https://ontara.dev/ontology/bmm/> .
@prefix ontara-cafe: <https://ontara.dev/ontology/tenant/cafe/> .
@prefix ontara-rsn: <https://ontara.dev/ontology/reasoning/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# Ontology declaration
# =============================================================================

<https://ontara.dev/data/cafe/reasoning/> a owl:Ontology ;
    rdfs:label "Cafe Reasoning Instances"@en ;
    dcterms:created "2026-11-01" ;
    owl:imports <https://ontara.dev/ontology/bmm/axioms> ,
                <https://ontara.dev/ontology/tenant-types/> ,
                ontara-rsn: ;
    rdfs:comment """OWL named individuals for the Cafe (coffee shop demonstrator),
patterned on the Ears module (ears-reasoning-instances.ttl). H-0055.

Created Session 518 (Plan B Stage 0, S0.4). It holds only what Stage 0
needs:
  1. The status-axis declarations of the Cafe's two canonical runtime
     types, CoffeeShop::Order (lifecycle, payment) and
     CoffeeShop::OrderLine (preparation), as StatusAxis, ValueSpace and
     AxisTransition individuals.
  2. The Cafe's cross-axis rule (no line moves from queued to in
     preparation while its order's payment is unpaid), as an
     AxisPrecondition individual that is also a reasoning HardConstraint:
     a boundary a move cannot cross.

Source of truth: the SysML model,
exercises/coffeeshop-demonstrator/model/domain/coffeeshop.sysml. This
file restates those declarations for the knowledge graph and must be
changed with them; values are strings exactly as in the model.

The types themselves (ontara-cafe:Order, ontara-cafe:OrderLine) and their
grounding as information content entities are generated by the OWL
pipeline into generated/ontology/ontara-tenant-types.ttl. Runtime orders
and lines are not here: they are runtime store content (S0.5).

IRI namespace: https://ontara.dev/data/cafe/reasoning/ (data namespace,
per the IRI scheme). All individuals use the cafe-rsn: prefix."""@en ;
    owl:versionInfo "Session 518 — S0.4 initial population: three axes, twelve moves, one cross-axis precondition"@en .


# =============================================================================
# SECTION 1: Order — lifecycle axis
# =============================================================================

cafe-rsn:order-lifecycle-axis a owl:NamedIndividual , ontara-bmm:StatusAxis ;
    rdfs:label "Order lifecycle axis"@en ;
    rdfs:comment "The order's stage, from placed through preparation to ready and collected, derived from its lines. Cancelled is a terminal branch outside the ordering, reached at the counter before the order is ready."@en ;
    ontara-axis:axisDeclaredOn ontara-cafe:Order ;
    ontara-axis:axisName "lifecycle" ;
    ontara-axis:defaultValue "placed" ;
    ontara-axis:hasValueSpace cafe-rsn:order-lifecycle-values ;
    ontara-axis:permitsTransition cafe-rsn:order-lifecycle-placedToInPreparation ,
                                cafe-rsn:order-lifecycle-inPreparationToReady ,
                                cafe-rsn:order-lifecycle-readyToCollected ,
                                cafe-rsn:order-lifecycle-placedToCancelled ,
                                cafe-rsn:order-lifecycle-inPreparationToCancelled .

cafe-rsn:order-lifecycle-values a owl:NamedIndividual , ontara-bmm:ValueSpace ;
    rdfs:label "Order lifecycle values"@en ;
    ontara-axis:valueShape "orderedEnum" ;
    ontara-axis:enumValue "placed" , "inPreparation" , "ready" , "collected" , "cancelled" .

cafe-rsn:order-lifecycle-placedToInPreparation a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "first line enters preparation"@en ;
    ontara-axis:fromValue "placed" ;
    ontara-axis:toValue "inPreparation" ;
    ontara-axis:triggerEvent "PreparationStarted" ;
    ontara-axis:requiredAuthority "systemSide" .

cafe-rsn:order-lifecycle-inPreparationToReady a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "every line is ready"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:toValue "ready" ;
    ontara-axis:triggerEvent "PreparationComplete" ;
    ontara-axis:requiredAuthority "systemSide" .

cafe-rsn:order-lifecycle-readyToCollected a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "every line is collected"@en ;
    ontara-axis:fromValue "ready" ;
    ontara-axis:toValue "collected" ;
    ontara-axis:triggerEvent "OrderCollected" ;
    ontara-axis:requiredAuthority "systemSide" .

cafe-rsn:order-lifecycle-placedToCancelled a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "Cancel Order"@en ;
    ontara-axis:fromValue "placed" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "CancellationRequested" ;
    ontara-axis:requiredAuthority "operatorSide" .

cafe-rsn:order-lifecycle-inPreparationToCancelled a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "Cancel Order"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "CancellationRequested" ;
    ontara-axis:requiredAuthority "operatorSide" .


# =============================================================================
# SECTION 2: Order — payment axis
# =============================================================================

cafe-rsn:order-payment-axis a owl:NamedIndividual , ontara-bmm:StatusAxis ;
    rdfs:label "Order payment axis"@en ;
    rdfs:comment "Whether the order has been paid, taken at the till. A cancelled order keeps the payment value it had; no refund is modelled at Stage 0."@en ;
    ontara-axis:axisDeclaredOn ontara-cafe:Order ;
    ontara-axis:axisName "payment" ;
    ontara-axis:defaultValue "unpaid" ;
    ontara-axis:hasValueSpace cafe-rsn:order-payment-values ;
    ontara-axis:permitsTransition cafe-rsn:order-payment-unpaidToPaid .

cafe-rsn:order-payment-values a owl:NamedIndividual , ontara-bmm:ValueSpace ;
    rdfs:label "Order payment values"@en ;
    ontara-axis:valueShape "orderedEnum" ;
    ontara-axis:enumValue "unpaid" , "paid" .

cafe-rsn:order-payment-unpaidToPaid a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "Till: Take Payment"@en ;
    ontara-axis:fromValue "unpaid" ;
    ontara-axis:toValue "paid" ;
    ontara-axis:triggerEvent "PaymentTaken" ;
    ontara-axis:requiredAuthority "operatorSide" .


# =============================================================================
# SECTION 3: Order line — preparation axis
# =============================================================================

cafe-rsn:orderline-preparation-axis a owl:NamedIndividual , ontara-bmm:StatusAxis ;
    rdfs:label "Order line preparation axis"@en ;
    rdfs:comment "How far the line's item has got, from queued through preparation to ready and collected. Cancelled is a terminal branch outside the ordering, set when the line's order is cancelled."@en ;
    ontara-axis:axisDeclaredOn ontara-cafe:OrderLine ;
    ontara-axis:axisName "preparation" ;
    ontara-axis:defaultValue "queued" ;
    ontara-axis:hasValueSpace cafe-rsn:orderline-preparation-values ;
    ontara-axis:permitsTransition cafe-rsn:orderline-preparation-queuedToInPreparation ,
                                cafe-rsn:orderline-preparation-inPreparationToReady ,
                                cafe-rsn:orderline-preparation-readyToCollected ,
                                cafe-rsn:orderline-preparation-queuedToCancelled ,
                                cafe-rsn:orderline-preparation-inPreparationToCancelled ,
                                cafe-rsn:orderline-preparation-readyToCancelled .

cafe-rsn:orderline-preparation-values a owl:NamedIndividual , ontara-bmm:ValueSpace ;
    rdfs:label "Order line preparation values"@en ;
    ontara-axis:valueShape "orderedEnum" ;
    ontara-axis:enumValue "queued" , "inPreparation" , "ready" , "collected" , "cancelled" .

cafe-rsn:orderline-preparation-queuedToInPreparation a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "Barista: Start Preparation"@en ;
    ontara-axis:fromValue "queued" ;
    ontara-axis:toValue "inPreparation" ;
    ontara-axis:triggerEvent "LinePreparationStarted" ;
    ontara-axis:requiredAuthority "operatorSide" , "systemSide" ;
    ontara-axis:hasPrecondition cafe-rsn:orderline-orderPaid .

cafe-rsn:orderline-preparation-inPreparationToReady a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "Barista: Mark Ready"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:toValue "ready" ;
    ontara-axis:triggerEvent "LinePreparationComplete" ;
    ontara-axis:requiredAuthority "operatorSide" , "systemSide" .

cafe-rsn:orderline-preparation-readyToCollected a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "Customer: Collect Drink"@en ;
    ontara-axis:fromValue "ready" ;
    ontara-axis:toValue "collected" ;
    ontara-axis:triggerEvent "LineCollected" ;
    ontara-axis:requiredAuthority "operatorSide" .

cafe-rsn:orderline-preparation-queuedToCancelled a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "line cancelled with its order"@en ;
    ontara-axis:fromValue "queued" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "LineCancelled" ;
    ontara-axis:requiredAuthority "systemSide" .

cafe-rsn:orderline-preparation-inPreparationToCancelled a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "line cancelled with its order"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "LineCancelled" ;
    ontara-axis:requiredAuthority "systemSide" .

cafe-rsn:orderline-preparation-readyToCancelled a owl:NamedIndividual , ontara-bmm:AxisTransition ;
    rdfs:label "line cancelled with its order"@en ;
    ontara-axis:fromValue "ready" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "LineCancelled" ;
    ontara-axis:requiredAuthority "systemSide" .


# =============================================================================
# SECTION 4: The cross-axis rule (S0.4 item 4)
# =============================================================================
#
# A HardConstraint in the reasoning vocabulary: a boundary that cannot be
# crossed (S146-D8). S151's Cafe instantiation of HardConstraint is food
# hygiene and allergen rules; this is the same kind of boundary on a move.
# Both classes are information content entities, so the double typing is
# satisfiable.

cafe-rsn:orderline-orderPaid a owl:NamedIndividual , ontara-bmm:AxisPrecondition , ontara-rsn:HardConstraint ;
    rdfs:label "Order paid before line preparation"@en ;
    rdfs:comment "The order is not paid. A line cannot start preparation until its order is paid."@en ;
    ontara-axis:relatedVia "order" ;
    ontara-axis:requiredAxis "payment" ;
    ontara-axis:requiredValue "paid" .
