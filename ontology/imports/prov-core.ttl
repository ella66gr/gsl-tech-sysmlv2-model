@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# PROV-O Core Subset for Ontara
# =============================================================================
#
# A faithful subset of the W3C PROV Ontology (PROV-O), W3C Recommendation
# 30 April 2013. Contains only the Starting Point classes and properties
# needed by the Ontara reasoning metamodel.
#
# This file exists because:
#   1. The Stage 7 plan (§2) explicitly scopes to PROV-O core subset only.
#   2. The full PROV-O file includes OWL-RL constructs and Qualifications
#      module axioms that are unnecessary for our purposes and could
#      introduce OWL 2 DL profile complications.
#   3. We need precise control over what enters the ontology stack for
#      HermiT reasoning.
#
# Source:   https://www.w3.org/TR/prov-o/ (Starting Point Terms, §3.1)
# IRI:      http://www.w3.org/ns/prov# (all terms use canonical W3C IRIs)
# Design:   S146-D2 (PROV-O as platform-level import)
#           S147-D4 (dual subclassing — Ontara classes subclass both BFO and PROV-O)
# Session:  150
#
# =============================================================================


# -----------------------------------------------------------------------------
# Ontology declaration
# -----------------------------------------------------------------------------

<http://www.w3.org/ns/prov#core> a owl:Ontology ;
    rdfs:label "PROV-O Core Subset (Ontara Import)"@en ;
    rdfs:comment """Core subset of the W3C PROV Ontology for the Ontara platform.
Contains the three Starting Point classes (Entity, Activity, Agent) and
the key Starting Point properties. Authored for the Ontara ontology stack
to ensure OWL 2 DL compatibility and minimal import footprint.
Full PROV-O: https://www.w3.org/TR/prov-o/"""@en ;
    owl:versionInfo "Session 150 — PROV-O core subset for Ontara reasoning metamodel"@en .


# =============================================================================
# Starting Point Classes (PROV-O §3.1)
# =============================================================================

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary."@en .

prov:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities."@en .

prov:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity."@en .


# =============================================================================
# Starting Point Properties (PROV-O §3.1)
# =============================================================================

# --- Entity properties ---

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "wasGeneratedBy"@en ;
    rdfs:comment "Generation is the completion of production of a new entity by an activity."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Activity .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "wasDerivedFrom"@en ;
    rdfs:comment "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "wasAttributedTo"@en ;
    rdfs:comment "Attribution is the ascribing of an entity to an agent."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent .

# --- Activity properties ---

prov:used a owl:ObjectProperty ;
    rdfs:label "used"@en ;
    rdfs:comment "Usage is the beginning of utilizing an entity by an activity. Before usage, the activity had not begun to utilize this entity and could not have been affected by the entity."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:wasInformedBy a owl:ObjectProperty ;
    rdfs:label "wasInformedBy"@en ;
    rdfs:comment "Communication is the exchange of some unspecified entity by two activities, one activity using some entity generated by the other."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Activity .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "wasAssociatedWith"@en ;
    rdfs:comment "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Agent .

prov:wasStartedBy a owl:ObjectProperty ;
    rdfs:label "wasStartedBy"@en ;
    rdfs:comment "Start is when an activity is deemed to have been started by an entity, known as trigger."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:wasEndedBy a owl:ObjectProperty ;
    rdfs:label "wasEndedBy"@en ;
    rdfs:comment "End is when an activity is deemed to have been ended by an entity, known as trigger."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

# --- Agent properties ---

prov:actedOnBehalfOf a owl:ObjectProperty ;
    rdfs:label "actedOnBehalfOf"@en ;
    rdfs:comment "Delegation is the assignment of authority and responsibility to an agent (by itself or by another agent) to carry out a specific activity as a delegate or representative."@en ;
    rdfs:domain prov:Agent ;
    rdfs:range prov:Agent .

# --- Datatype properties (time) ---

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "startedAtTime"@en ;
    rdfs:comment "The time at which an activity started."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:dateTime .

prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "endedAtTime"@en ;
    rdfs:comment "The time at which an activity ended."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:dateTime .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generatedAtTime"@en ;
    rdfs:comment "The time at which an entity was completely created."@en ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:dateTime .


# =============================================================================
# End of PROV-O Core Subset
# =============================================================================
