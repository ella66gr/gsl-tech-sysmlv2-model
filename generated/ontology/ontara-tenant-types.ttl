@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cafe-rsn: <https://ontara.dev/data/cafe/reasoning/> .
@prefix ontara-axis: <https://ontara.dev/ontology/bmm/axis#> .
@prefix ontara-bmm: <https://ontara.dev/ontology/bmm/> .
@prefix ontara-cafe: <https://ontara.dev/ontology/tenant/cafe/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

skos:notation a owl:AnnotationProperty .

cafe-rsn:order-lifecycle-axis a owl:NamedIndividual,
        ontara-bmm:StatusAxis ;
    rdfs:label "Order lifecycle axis"@en ;
    rdfs:comment "The order's stage, from placed through preparation to ready and collected, derived from its lines. Cancelled is a terminal branch outside the ordering, reached at the counter before the order is ready."@en ;
    ontara-axis:axisDeclaredOn ontara-cafe:Order ;
    ontara-axis:axisName "lifecycle" ;
    ontara-axis:defaultValue "placed" ;
    ontara-axis:hasValueSpace cafe-rsn:order-lifecycle-values ;
    ontara-axis:permitsTransition cafe-rsn:order-lifecycle-inPreparationToCancelled,
        cafe-rsn:order-lifecycle-inPreparationToReady,
        cafe-rsn:order-lifecycle-placedToCancelled,
        cafe-rsn:order-lifecycle-placedToInPreparation,
        cafe-rsn:order-lifecycle-readyToCollected ;
    ontara-axis:valuePredicate ontara-cafe:orderLifecycle .

cafe-rsn:order-payment-axis a owl:NamedIndividual,
        ontara-bmm:StatusAxis ;
    rdfs:label "Order payment axis"@en ;
    rdfs:comment "Whether the order has been paid, taken at the till. A cancelled order keeps the payment value it had; no refund is modelled at Stage 0."@en ;
    ontara-axis:axisDeclaredOn ontara-cafe:Order ;
    ontara-axis:axisName "payment" ;
    ontara-axis:defaultValue "unpaid" ;
    ontara-axis:hasValueSpace cafe-rsn:order-payment-values ;
    ontara-axis:permitsTransition cafe-rsn:order-payment-unpaidToPaid ;
    ontara-axis:valuePredicate ontara-cafe:orderPayment .

cafe-rsn:orderline-preparation-axis a owl:NamedIndividual,
        ontara-bmm:StatusAxis ;
    rdfs:label "Order line preparation axis"@en ;
    rdfs:comment "How far the line's item has got, from queued through preparation to ready and collected. Cancelled is a terminal branch outside the ordering, set when the line's order is cancelled."@en ;
    ontara-axis:axisDeclaredOn ontara-cafe:OrderLine ;
    ontara-axis:axisName "preparation" ;
    ontara-axis:defaultValue "queued" ;
    ontara-axis:hasValueSpace cafe-rsn:orderline-preparation-values ;
    ontara-axis:permitsTransition cafe-rsn:orderline-preparation-inPreparationToCancelled,
        cafe-rsn:orderline-preparation-inPreparationToReady,
        cafe-rsn:orderline-preparation-queuedToCancelled,
        cafe-rsn:orderline-preparation-queuedToInPreparation,
        cafe-rsn:orderline-preparation-readyToCancelled,
        cafe-rsn:orderline-preparation-readyToCollected ;
    ontara-axis:valuePredicate ontara-cafe:orderLinePreparation .

<https://ontara.dev/ontology/tenant-types/> a owl:Ontology ;
    rdfs:label "Ontara Tenant Canonical Runtime Types"@en ;
    rdfs:comment "Generated by gen_owl_pipeline.py (Stage 3g, Session 518). The tenant canonical runtime types, their status-axis declarations and their runtime axis vocabulary. The types are tenant part defs that specialise CanonicalRuntimeType and carry @BfoType, each in its tenant's ontology namespace, grounded under its BFO or IAO parent. Their axis declarations (StatusAxis, ValueSpace, AxisTransition and AxisPrecondition individuals) are in the tenant's reasoning-data namespace, and the runtime axis vocabulary (one predicate per axis, one AxisValue individual per value) in its ontology namespace (S0.5 Pass B8, H-0647); all IRIs from generation/axis_iris.py. Merged with the BMM ontology (ontara-bmm.ttl) in the stack; declares no imports, as ontara-bmm.ttl declares none."@en .

cafe-rsn:order-lifecycle-inPreparationToCancelled a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "Cancel Order"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:requiredAuthority "operatorSide" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "CancellationRequested" .

cafe-rsn:order-lifecycle-inPreparationToReady a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "every line is ready"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:requiredAuthority "systemSide" ;
    ontara-axis:toValue "ready" ;
    ontara-axis:triggerEvent "PreparationComplete" .

cafe-rsn:order-lifecycle-placedToCancelled a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "Cancel Order"@en ;
    ontara-axis:fromValue "placed" ;
    ontara-axis:requiredAuthority "operatorSide" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "CancellationRequested" .

cafe-rsn:order-lifecycle-placedToInPreparation a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "first line enters preparation"@en ;
    ontara-axis:fromValue "placed" ;
    ontara-axis:requiredAuthority "systemSide" ;
    ontara-axis:toValue "inPreparation" ;
    ontara-axis:triggerEvent "PreparationStarted" .

cafe-rsn:order-lifecycle-readyToCollected a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "every line is collected"@en ;
    ontara-axis:fromValue "ready" ;
    ontara-axis:requiredAuthority "systemSide" ;
    ontara-axis:toValue "collected" ;
    ontara-axis:triggerEvent "OrderCollected" .

cafe-rsn:order-lifecycle-values a owl:NamedIndividual,
        ontara-bmm:ValueSpace ;
    rdfs:label "Order lifecycle values"@en ;
    ontara-axis:enumValue "cancelled",
        "collected",
        "inPreparation",
        "placed",
        "ready" ;
    ontara-axis:permitsValue ontara-cafe:OrderLifecycle-cancelled,
        ontara-cafe:OrderLifecycle-collected,
        ontara-cafe:OrderLifecycle-inPreparation,
        ontara-cafe:OrderLifecycle-placed,
        ontara-cafe:OrderLifecycle-ready ;
    ontara-axis:valueShape "orderedEnum" .

cafe-rsn:order-payment-unpaidToPaid a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "Till: Take Payment"@en ;
    ontara-axis:fromValue "unpaid" ;
    ontara-axis:requiredAuthority "operatorSide" ;
    ontara-axis:toValue "paid" ;
    ontara-axis:triggerEvent "PaymentTaken" .

cafe-rsn:order-payment-values a owl:NamedIndividual,
        ontara-bmm:ValueSpace ;
    rdfs:label "Order payment values"@en ;
    ontara-axis:enumValue "paid",
        "unpaid" ;
    ontara-axis:permitsValue ontara-cafe:OrderPayment-paid,
        ontara-cafe:OrderPayment-unpaid ;
    ontara-axis:valueShape "orderedEnum" .

cafe-rsn:orderline-orderPaid a owl:NamedIndividual,
        ontara-bmm:AxisPrecondition ;
    rdfs:comment "The order is not paid. A line cannot start preparation until its order is paid."@en ;
    ontara-axis:relatedVia "order" ;
    ontara-axis:requiredAxis "payment" ;
    ontara-axis:requiredValue "paid" .

cafe-rsn:orderline-preparation-inPreparationToCancelled a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "line cancelled with its order"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:requiredAuthority "systemSide" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "LineCancelled" .

cafe-rsn:orderline-preparation-inPreparationToReady a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "Barista: Mark Ready"@en ;
    ontara-axis:fromValue "inPreparation" ;
    ontara-axis:requiredAuthority "operatorSide",
        "systemSide" ;
    ontara-axis:toValue "ready" ;
    ontara-axis:triggerEvent "LinePreparationComplete" .

cafe-rsn:orderline-preparation-queuedToCancelled a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "line cancelled with its order"@en ;
    ontara-axis:fromValue "queued" ;
    ontara-axis:requiredAuthority "systemSide" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "LineCancelled" .

cafe-rsn:orderline-preparation-queuedToInPreparation a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "Barista: Start Preparation"@en ;
    ontara-axis:fromValue "queued" ;
    ontara-axis:hasPrecondition cafe-rsn:orderline-orderPaid ;
    ontara-axis:requiredAuthority "operatorSide",
        "systemSide" ;
    ontara-axis:toValue "inPreparation" ;
    ontara-axis:triggerEvent "LinePreparationStarted" .

cafe-rsn:orderline-preparation-readyToCancelled a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "line cancelled with its order"@en ;
    ontara-axis:fromValue "ready" ;
    ontara-axis:requiredAuthority "systemSide" ;
    ontara-axis:toValue "cancelled" ;
    ontara-axis:triggerEvent "LineCancelled" .

cafe-rsn:orderline-preparation-readyToCollected a owl:NamedIndividual,
        ontara-bmm:AxisTransition ;
    rdfs:label "Customer: Collect Drink"@en ;
    ontara-axis:fromValue "ready" ;
    ontara-axis:requiredAuthority "operatorSide" ;
    ontara-axis:toValue "collected" ;
    ontara-axis:triggerEvent "LineCollected" .

cafe-rsn:orderline-preparation-values a owl:NamedIndividual,
        ontara-bmm:ValueSpace ;
    rdfs:label "Order line preparation values"@en ;
    ontara-axis:enumValue "cancelled",
        "collected",
        "inPreparation",
        "queued",
        "ready" ;
    ontara-axis:permitsValue ontara-cafe:OrderLinePreparation-cancelled,
        ontara-cafe:OrderLinePreparation-collected,
        ontara-cafe:OrderLinePreparation-inPreparation,
        ontara-cafe:OrderLinePreparation-queued,
        ontara-cafe:OrderLinePreparation-ready ;
    ontara-axis:valueShape "orderedEnum" .

ontara-cafe:OrderLifecycle-cancelled a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "cancelled"@en ;
    skos:notation "cancelled" .

ontara-cafe:OrderLifecycle-collected a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "collected"@en ;
    skos:notation "collected" .

ontara-cafe:OrderLifecycle-inPreparation a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "in preparation"@en ;
    skos:notation "inPreparation" .

ontara-cafe:OrderLifecycle-placed a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "placed"@en ;
    skos:notation "placed" .

ontara-cafe:OrderLifecycle-ready a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "ready"@en ;
    skos:notation "ready" .

ontara-cafe:OrderLine a owl:Class ;
    rdfs:label "Order Line"@en ;
    rdfs:comment "One item asked for on an order, with its quantity and its own preparation status."@en ;
    rdfs:subClassOf bfo:IAO_0000030,
        ontara-bmm:CanonicalRuntimeType ;
    skos:definition "One item on a customer order, with its quantity and, optionally, who it is for. Each line is prepared and collected on its own, so it carries its own preparation status: queued, in preparation, ready, collected, or cancelled if its order is cancelled. A line cannot start preparation until its order is paid."@en .

ontara-cafe:OrderLinePreparation-cancelled a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "cancelled"@en ;
    skos:notation "cancelled" .

ontara-cafe:OrderLinePreparation-collected a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "collected"@en ;
    skos:notation "collected" .

ontara-cafe:OrderLinePreparation-inPreparation a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "in preparation"@en ;
    skos:notation "inPreparation" .

ontara-cafe:OrderLinePreparation-queued a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "queued"@en ;
    skos:notation "queued" .

ontara-cafe:OrderLinePreparation-ready a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "ready"@en ;
    skos:notation "ready" .

ontara-cafe:OrderPayment-paid a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "paid"@en ;
    skos:notation "paid" .

ontara-cafe:OrderPayment-unpaid a owl:NamedIndividual,
        ontara-axis:AxisValue ;
    rdfs:label "unpaid"@en ;
    skos:notation "unpaid" .

ontara-cafe:orderLifecycle a owl:ObjectProperty ;
    rdfs:label "order lifecycle"@en ;
    rdfs:comment "Runtime predicate of the lifecycle axis of Order (CoffeeShop::Order::lifecycleAxis): its object is the instance's current lifecycle value, one of the values its value space permits. Generated by gen_owl_pipeline.py Stage 3g (S0.5 Pass B8, H-0647)."@en ;
    rdfs:subPropertyOf ontara-axis:hasAxisValue .

ontara-cafe:orderLinePreparation a owl:ObjectProperty ;
    rdfs:label "order line preparation"@en ;
    rdfs:comment "Runtime predicate of the preparation axis of Order Line (CoffeeShop::OrderLine::preparationAxis): its object is the instance's current preparation value, one of the values its value space permits. Generated by gen_owl_pipeline.py Stage 3g (S0.5 Pass B8, H-0647)."@en ;
    rdfs:subPropertyOf ontara-axis:hasAxisValue .

ontara-cafe:orderPayment a owl:ObjectProperty ;
    rdfs:label "order payment"@en ;
    rdfs:comment "Runtime predicate of the payment axis of Order (CoffeeShop::Order::paymentAxis): its object is the instance's current payment value, one of the values its value space permits. Generated by gen_owl_pipeline.py Stage 3g (S0.5 Pass B8, H-0647)."@en ;
    rdfs:subPropertyOf ontara-axis:hasAxisValue .

ontara-cafe:Order a owl:Class ;
    rdfs:label "Order"@en ;
    rdfs:comment "A customer's order of one or more items, with its lifecycle and payment status."@en ;
    rdfs:subClassOf bfo:IAO_0000030,
        ontara-bmm:CanonicalRuntimeType ;
    skos:definition "What a customer asked for, as one or more order lines. An order carries two independent statuses. Its lifecycle runs from placed through in preparation and ready to collected, and follows its lines: it is never moved to ready or collected directly. It can be cancelled at the counter before it is ready. Its payment runs from unpaid to paid, taken at the till."@en .

