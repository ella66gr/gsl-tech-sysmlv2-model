@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontara-bmm: <https://ontara.dev/ontology/bmm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ontara-bmm: a owl:Ontology ;
    rdfs:label "Ontara Business Meta Model"@en ;
    dcterms:created "2026-04-01"^^xsd:date ;
    rdfs:comment "OWL representation of the 34 BMM part defs from the Ontara platform. Each class is positioned under its BFO 2020 parent via @BfoType annotations."@en ;
    owl:versionInfo "Generated by gen_owl_pipeline.py — Session 105"@en .

ontara-bmm:ActivityBudget a owl:Class ;
    rdfs:label "Activity Budget"@en ;
    rdfs:comment "A planned allocation of activity volume by type and period."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A planned allocation of how much activity of each type your business expects in a given period — the activity-level equivalent of a financial budget. When you define an activity budget, the system can compare what actually happened against what was planned, and surface gaps."@en .

ontara-bmm:ActivityCostAllocation a owl:Class ;
    rdfs:label "Activity Cost Allocation"@en ;
    rdfs:comment "The mapping from an activity type to its financial cost."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "The mapping from an activity to its financial cost — how much does it cost each time this kind of work is done? When you define cost allocations, the system can connect your activity model to your financial model, making resource consumption visible in financial terms."@en .

ontara-bmm:ActivityGranularity a owl:Class ;
    rdfs:label "Activity Granularity"@en ;
    rdfs:comment "A policy declaration of how precisely activity is tracked in a given area."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A policy declaration: how precisely does your business track activity in a given area? The system supports three levels — envelope (a rough total), category (broken down by type), and tracked (every individual activity recorded). Different parts of your business can operate at different levels at the same time, and you can refine the level as your needs evolve."@en .

ontara-bmm:ActivityRecord a owl:Class ;
    rdfs:label "Activity Record"@en ;
    rdfs:comment "A recorded instance of an activity that actually happened."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A recorded instance of an activity that actually happened — the system's record that a specific piece of work was done, by whom, for how long, and using what resources. At the most detailed tracking level, the system creates one of these for every observable activity. At coarser levels, they are estimated aggregates."@en .

ontara-bmm:ActivityType a owl:Class ;
    rdfs:label "Activity Type"@en ;
    rdfs:comment "A defined kind of business activity, classified into one of five categories."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "Something your business does — an identifiable unit of work that the system holds, tracks, and uses. In this system, every activity is an activity of one of the following types: service delivery, enabling, governance, development, or overhead. When you assign one of these types to an activity, the system will use that information to plan resources, allocate costs, and verify that governance requirements are being met for each kind of work."@en .

ontara-bmm:AuditEvidenceRecord a owl:Class ;
    rdfs:label "Audit Evidence Record"@en ;
    rdfs:comment "A record that demonstrates compliance with a governance requirement — the proof that obligations are met."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A record that proves your business is meeting a governance requirement — what was checked, when, by whom, and how often. The system tracks these as concrete evidence items tied to specific obligations. When you define audit evidence records, the system knows what proof exists and can surface gaps where evidence is missing or overdue."@en .

ontara-bmm:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:comment "An organised combination of resources that produces a defined service function."@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "An organised combination of resources that together produce a defined service function — like 'the ability to conduct a monitoring review' (which requires a clinician, a lab interface, and a clinical record system). You don't deliver services with individual resources; you deliver them with capabilities. When you define capabilities, the system connects your resources to the service offerings they enable."@en .

ontara-bmm:CapacityModel a owl:Class ;
    rdfs:label "Capacity Model"@en ;
    rdfs:comment "The relationship between your resource configuration and service throughput."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "The relationship between your resource configuration and how much service you can deliver — for example, 'with one clinician at 0.5 FTE, we can support 20 active patients.' This is a planning assertion that the system holds, not a computed formula. When you define a capacity model, the system knows your throughput limits and can surface when you're approaching them."@en .

ontara-bmm:CatalogueEntry a owl:Class ;
    rdfs:label "Catalogue Entry"@en ;
    rdfs:comment "A record of something your business has decided to offer, with its price and status."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A record of something your business has decided to offer — whether that's a menu item, a treatment, a course, or any other unit you sell or provide. The catalogue entry connects what the thing intrinsically is to how your business offers it: its price, availability, and status. When you add a catalogue entry, the system tracks it as part of your active offering."@en .

ontara-bmm:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:comment "A way that customers find, reach, or receive your service."@en ;
    rdfs:subClassOf cco:ont00000323 ;
    skos:definition "A way that customers find you, reach you, or receive your service — your website, a referral network, a walk-in counter, an app. When you define your channels, the system tracks which customer segments each channel serves and how your service offerings are delivered through them."@en .

ontara-bmm:CommunityRelationship a owl:Class ;
    rdfs:label "Community Relationship"@en ;
    rdfs:comment "The business's connection to its broader community of interest — constitutive, not transactional."@en ;
    rdfs:subClassOf bfo:BFO_0000031 ;
    skos:definition "Your business's connection to its broader community of interest — the people, organisations, and networks that share your purpose or are affected by your work. Community relationships are constitutive of your identity, not transactional. When you define community relationships, the system tracks how communities shape your service and how you engage with them."@en .

ontara-bmm:CooperativeArrangement a owl:Class ;
    rdfs:label "Cooperative Arrangement"@en ;
    rdfs:comment "A formalised agreement to jointly deliver or manage something — neither party can deliver independently."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A formalised arrangement where your business and another entity jointly deliver or manage something that neither could do alone — a shared care protocol, a delivery partnership, a joint training programme. When you define cooperative arrangements, the system tracks what is jointly produced, how responsibility is divided, and how the arrangement's effectiveness is assessed."@en .

ontara-bmm:CostDriver a owl:Class ;
    rdfs:label "Cost Driver"@en ;
    rdfs:comment "A structural factor that generates cost in the business — linked to a resource or activity."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A structural factor that generates cost in your business — something that, as it scales or recurs, drives your expenditure. Each cost driver is linked to a resource or an activity. When you define your cost drivers, the system connects your cost structure to the resources and activities that produce it, so you can see where money goes and why."@en .

ontara-bmm:CustomerSegment a owl:Class ;
    rdfs:label "Customer Segment"@en ;
    rdfs:comment "A defined group of customers with shared needs and willingness to pay."@en ;
    rdfs:subClassOf cco:ont00000300 ;
    skos:definition "A group of people your service is designed for — people who share similar needs and reasons for choosing you. When you define your customer segments, the system uses them to connect your value propositions, pricing, and channels to the right audiences."@en .

ontara-bmm:DifferentiationClaim a owl:Class ;
    rdfs:label "Differentiation Claim"@en ;
    rdfs:comment "An explicit, testable statement of how your service differs from alternatives."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "An explicit statement of how your service differs from the alternatives, from the customer's perspective. Each claim should be testable — something you can back up with evidence. When you define differentiation claims, the system records them as commitments your service is designed to fulfil."@en .

ontara-bmm:ExternalDependency a owl:Class ;
    rdfs:label "External Dependency"@en ;
    rdfs:comment "Something the business depends on that it does not control — characterised by asymmetric reliance."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "Something your business depends on that you do not control — a pharmaceutical supplier, a laboratory service, an equipment provider, a software platform. When you define external dependencies, the system tracks what you depend on, how critical each dependency is, what contingency plans exist, and what risks threaten continuity of supply."@en .

ontara-bmm:ExternalReference a owl:Class ;
    rdfs:label "External Reference"@en ;
    rdfs:comment "A link to authoritative knowledge that lives outside your system."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A link to knowledge that lives outside your system — a supplier datasheet, a regulatory standard, a clinical guideline, an accreditation body. The system doesn't own this information; it points to it, so you always know where authoritative external knowledge sits in relation to your service."@en .

ontara-bmm:FinancialProjection a owl:Class ;
    rdfs:label "Financial Projection"@en ;
    rdfs:comment "A forward-looking financial picture combining revenues, costs, and growth assumptions."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A named projection of your business's financial future over a defined period — combining your revenue streams, cost drivers, and growth assumptions into a forward-looking picture. When you define a financial projection, the system links it to a scenario so you can compare different versions of the future side by side."@en .

ontara-bmm:GovernanceRequirement a owl:Class ;
    rdfs:label "Governance Requirement"@en ;
    rdfs:comment "A regulatory or standards obligation that the business must satisfy, with defined evidence."@en ;
    rdfs:subClassOf bfo:IAO_0000005 ;
    skos:definition "A regulatory, legal, or standards obligation that your business must satisfy — and the system tracks it as a concrete, testable commitment, not just a policy statement. Each governance requirement is connected to the evidence that demonstrates compliance and, where formalised, to the constraint rules that the system can check. When you define governance requirements, the system builds a traceability chain from obligation through to proof."@en .

ontara-bmm:InventoryRecord a owl:Class ;
    rdfs:label "Inventory Record"@en ;
    rdfs:comment "A point-in-time record of stock level for a catalogue item."@en ;
    rdfs:subClassOf bfo:IAO_0000109 ;
    skos:definition "A point-in-time record of how much stock you have of something in your catalogue — how many tablets, how many bags of coffee beans, how many bottles of cleaning product. This is operational tracking: it tells the system what you have right now, so it can flag when you're running low. Distinct from resource planning, which is about strategic capacity."@en .

ontara-bmm:ObjectiveCapabilityMapping a owl:Class ;
    rdfs:label "Objective–Capability Mapping"@en ;
    rdfs:comment "A declared connection between a strategic objective and the capabilities that support it."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A declared connection between a strategic objective and the capabilities that contribute to achieving it. When you map objectives to capabilities, the system can trace from 'what are we trying to achieve?' down to 'what resources and service functions make that possible?' — closing the loop between strategy and operations."@en .

ontara-bmm:ParticipationModel a owl:Class ;
    rdfs:label "Participation Model"@en ;
    rdfs:comment "How the customer or patient participates as co-producer, not merely recipient, of the service."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "How your customer or patient participates in the service as a co-producer, not merely a recipient — the spectrum from passive recipient to active self-manager. When you define participation models, the system tracks what role participants play, how they contribute information and decisions, what they can do independently, and what support they need."@en .

ontara-bmm:PricingModel a owl:Class ;
    rdfs:label "Pricing Model"@en ;
    rdfs:comment "How prices are set for services — per-episode, subscription, tiered, or other basis."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "The logic that determines what a customer pays for a service — per-episode, subscription, tiered, sliding scale, or flat fee. When you define a pricing model, the system applies it to the relevant service offerings and uses it in revenue projections and unit economics calculations."@en .

ontara-bmm:ReferralPathway a owl:Class ;
    rdfs:label "Referral Pathway"@en ;
    rdfs:comment "A structured route for directing or receiving work between organisations."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A structured route for directing or receiving work between your business and another organisation — GP referrals coming in, specialist referrals going out, or bidirectional pathways where both directions operate. When you define referral pathways, the system tracks where work comes from and goes to, what criteria trigger referrals, and how volumes and outcomes are monitored."@en .

ontara-bmm:ResourceConstraint a owl:Class ;
    rdfs:label "Resource Constraint"@en ;
    rdfs:comment "A limit on resource availability that affects service delivery."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "A limit on the availability or use of a resource that affects your ability to deliver services — regulatory, financial, temporal, or contractual. When you define resource constraints, the system tracks them alongside your resources so that capacity planning reflects real-world limits, not just theoretical availability."@en .

ontara-bmm:ResourceInstance a owl:Class ;
    rdfs:label "Resource Instance"@en ;
    rdfs:comment "A specific resource available at a defined capacity and cost."@en ;
    rdfs:subClassOf cco:ont00001017 ;
    skos:definition "A specific resource available to your business at a defined capacity and cost — not a named individual, but a planning-level description like 'a prescribing clinician at 0.5 FTE' or 'one licensed copy of the booking system'. When you define resource instances, the system uses them to model your actual operating capacity."@en .

ontara-bmm:ResourceType a owl:Class ;
    rdfs:label "Resource Type"@en ;
    rdfs:comment "A category of resource needed to run the service — people, equipment, premises, or external services."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A kind of thing your business needs in order to operate — staff, equipment, premises, technology, or external services such as a laboratory or a contractor. The system holds each resource type as a tracked concept. When you define your resource types, the system uses them to plan capacity, understand your cost base, and identify where you might be constrained."@en .

ontara-bmm:RevenueStream a owl:Class ;
    rdfs:label "Revenue Stream"@en ;
    rdfs:comment "A mechanism by which the business generates income from its services."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A way your business earns money — each revenue stream connects a customer segment, a triggering event (like completing an assessment or renewing a subscription), and a pricing model. When you define your revenue streams, the system can project income and connect it to the services that generate it."@en .

ontara-bmm:ServiceOffering a owl:Class ;
    rdfs:label "Service Offering"@en ;
    rdfs:comment "A packaged unit of service that can be priced, resourced, and delivered to customers."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "A distinct service that your business offers — something a customer can choose, pay for, and receive. When you define a service offering, the system connects it to the activities required to deliver it, the resources it consumes, and the price the customer pays."@en .

ontara-bmm:ServiceParticipant a owl:Class ;
    rdfs:label "Service Participant"@en ;
    rdfs:comment "An entity involved in a service engagement in a defined role — customer, payer, commissioner, decision-maker, or any other role."@en ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    skos:definition "Any person or organisation involved in a service engagement in a defined role. The person who pays, the organisation that commissions, the carer who makes decisions, the expert called in for assessment — any entity with influence on how the service proceeds. When you identify your service participants, the system tracks who is involved, in what capacity, and how their status affects the service workflow. The set of possible roles is open — the model does not constrain what kinds of participation your service may involve."@en .

ontara-bmm:ServiceSubject a owl:Class ;
    rdfs:label "Service Subject"@en ;
    rdfs:comment "The entity upon which a service is performed — a person, animal, object, or organisation that receives the service."@en ;
    rdfs:subClassOf bfo:BFO_0000023 ;
    skos:definition "The thing your service acts on — the dog being groomed, the patient receiving care, the garment being cleaned, the item being repaired. A service subject may have needs independent of whoever commissioned the service, and governance obligations may attach to the subject directly. When you identify your service subjects, the system tracks what is being served, in what condition, and with what independent requirements — separately from who is paying or making decisions."@en .

ontara-bmm:StakeholderRelationship a owl:Class ;
    rdfs:label "Stakeholder Relationship"@en ;
    rdfs:comment "A typed, ongoing, structured relationship between the business and an external entity."@en ;
    rdfs:subClassOf bfo:BFO_0000031 ;
    skos:definition "A relationship your business has with an external entity — a regulator, a commissioning body, a professional organisation, a contractual partner, an advisory body, or a peer. Each relationship has a defined nature, mutual obligations, and a health profile. When you define stakeholder relationships, the system tracks who you interact with, what you owe each other, and whether the relationship is working well."@en .

ontara-bmm:UnitEconomics a owl:Class ;
    rdfs:label "Unit Economics"@en ;
    rdfs:comment "The revenue, cost, and margin for a single unit of service delivery."@en ;
    rdfs:subClassOf bfo:IAO_0000030 ;
    skos:definition "The financial profile of delivering one unit of a service — what you earn, what it costs, and the margin between them. When you define unit economics for each service offering, the system can assess whether individual services are financially viable and how changes to pricing or costs would affect the picture."@en .

ontara-bmm:ValueProposition a owl:Class ;
    rdfs:label "Value Proposition"@en ;
    rdfs:comment "A promise of value to a customer segment — what they get and why it matters."@en ;
    rdfs:subClassOf bfo:IAO_0000104 ;
    skos:definition "The core promise your service makes to a particular group of customers — what they get from you and why they'd choose you over the alternatives. When you define a value proposition, the system holds it as the anchor that your activities, resources, and pricing all exist to deliver."@en .

